{
    "name": "smartbiz-api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node dist-api/index.js",
        "start:render": "node dist-server/index.js",
        "test": "jest",
        "build": "npx ncc build api/index.ts -o dist-api && node -e \"const fs = require('fs'); if (!fs.existsSync('public')) fs.mkdirSync('public'); fs.writeFileSync('public/index.html', '<h1>SmartBiz API Running</h1>');\"",
        "build:render": "npx ncc build src/index.ts -o dist-server"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.9",
        "@hono/zod-validator": "^0.1.11",
        "@smartbiz/db": "file:../../packages/db",
        "@smartbiz/shared": "file:../../packages/shared",
        "@supabase/supabase-js": "^2.39.0",
        "dotenv": "^16.3.1",
        "drizzle-orm": "latest",
        "hono": "^4.0.0",
        "postgres": "^3.4.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@vercel/ncc": "^0.38.1",
        "tsx": "4.19.3",
        "typescript": "^5.3.3"
    }
}