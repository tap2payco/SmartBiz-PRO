# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Auth (Remote)
# These variables are typically used for a deployed Supabase instance.
# If you are using local Supabase, the above 'Supabase Configuration' block applies.
NEXT_PUBLIC_SUPABASE_URL_AUTH=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_AUTH=your-anon-key
SUPABASE_SERVICE_ROLE_KEY_AUTH=your-service-role-key

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Example for remote Supabase database:
# DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# API Configuration
API_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3003

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# App Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# JWT Secret (generate a secure random string)
JWT_SECRET=your-jwt-secret-here

# Organization
DEFAULT_ORG_ID=

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=false
ENABLE_DEBUG=true
