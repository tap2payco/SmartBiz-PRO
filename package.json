{
  "name": "smartbiz-pro-erp",
  "version": "1.0.0",
  "private": true,
  "description": "SmartBiz Pro ERP - Offline-first ERP for Retail & Wholesale",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "cd packages/db && npm run generate",
    "db:migrate": "cd packages/db && npm run migrate",
    "db:studio": "cd packages/db && npm run studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "babel-preset-expo": "^54.0.10",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
